<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <ProductionRoot Condition="'$(Baseline)' != 'true'">../..</ProductionRoot>
    <ProductionRoot Condition="'$(Baseline)' == 'true'">../../.build/review-033-baseline</ProductionRoot>
    <DefineConstants Condition="'$(Baseline)' == 'true'">$(DefineConstants);BASELINE</DefineConstants>
    <GameRoot Condition="'$(GameRoot)' == ''">X:\SteamLibrary\steamapps\common\Risk of Rain 2</GameRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(ProductionRoot)/src/BastionChoreography.cs" Link="BastionChoreography.cs" />
    <Compile Include="$(ProductionRoot)/src/BastionPcm.cs" Link="BastionPcm.cs" />
    <Compile Include="../../src/BastionReadoutHistory.cs" Link="BastionReadoutHistory.cs" />
    <Compile Include="../../src/BastionAudioSession.cs" Link="BastionAudioSession.cs" Condition="'$(Baseline)' != 'true'" />
    <Compile Include="../../src/BastionAudioOutput.cs" Link="BastionAudioOutput.cs" Condition="'$(Baseline)' != 'true'" />
    <Compile Include="../../src/BastionWaveOut.cs" Link="BastionWaveOut.cs" Condition="'$(Baseline)' != 'true'" />
    <Compile Include="../../src/BastionPulseAudio.cs" Link="BastionPulseAudio.cs" Condition="'$(Baseline)' != 'true'" />
    <Compile Include="$(ProductionRoot)/src/BastionExplosionGeometry.cs" Link="BastionExplosionGeometry.cs" />
    <Compile Include="../../src/BastionDetonationPresentation.cs" Link="BastionDetonationPresentation.cs" Condition="'$(Baseline)' != 'true'" />
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameRoot)/Risk of Rain 2_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
