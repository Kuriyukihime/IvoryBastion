<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <GameRoot Condition="'$(GameRoot)' == ''">X:\SteamLibrary\steamapps\common\Risk of Rain 2</GameRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs"/>
    <Compile Include="../../src/BastionEffectGeometry.cs" Link="BastionEffectGeometry.cs"/>
    <Compile Include="../../src/BastionChoreography.cs" Link="BastionChoreography.cs"/>
    <Compile Include="../../src/BastionWarheadGeometry.cs" Link="BastionWarheadGeometry.cs"/>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameRoot)\Risk of Rain 2_Data\Managed\UnityEngine.CoreModule.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
