<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <ModProfile Condition="'$(ModProfile)' == ''">$(APPDATA)\Thunderstore Mod Manager\DataFolder\RiskOfRain2\profiles\My Profile</ModProfile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="LanguageApiStandIn.cs" />
    <Compile Include="../../src/BastionBalanceText.cs" Link="BastionBalanceText.cs" />
    <Compile Include="../../src/BastionNeedleRules.cs" Link="BastionNeedleRules.cs" />
    <Compile Include="../../src/BastionBalanceValues.cs" Link="BastionBalanceValues.cs" />
    <Reference Include="Mono.Cecil">
      <HintPath>$(ModProfile)\BepInEx\core\Mono.Cecil.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>X:/SteamLibrary/steamapps/common/Risk of Rain 2/Risk of Rain 2_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
